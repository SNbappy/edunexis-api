## .NET — standard gitignore (trimmed to essentials)
## https://github.com/dotnet/core/blob/main/.gitignore

# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# Visual Studio / VS Code
.vs/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Rider / JetBrains
.idea/
*.sln.iml

# User-specific
*.suo
*.user
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# Build logs + tooling
*.log
*.tmp
*.tlog
*.tlog.*

# Test results
[Tt]est[Rr]esult*/
coverage/
*.coverage
*.coveragexml

# MacOS / Windows noise
.DS_Store
Thumbs.db
ehthumbs.db

# Secrets / local env
appsettings.Local.json
*.env
.env.local

# EF Core generated SQL (optional — remove if you want to track migration scripts)
# migration.sql
